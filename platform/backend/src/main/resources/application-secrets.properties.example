DB_PASSWORD=postgres_password
JWT_SECRET=generate_a_long_random_base64_string
DB_URL=db_url
APP_JWT_COOKIE_SECURE=false

# --- Frontend URL used in emailed links (no trailing slash) ---
APP_FRONTEND_URL=http://localhost:5173

# --- Email. Leave APP_MAIL_ENABLED=false in development: invite and reset links are printed in the backend log.
# For real sending set it to true and fill in any SMTP provider's details (Resend, SES, Brevo, Gmail, ...).
# On a host such as Render, set the same values as environment variables instead (SPRING_MAIL_HOST, SPRING_MAIL_PORT, ...).
APP_MAIL_ENABLED=false
APP_MAIL_FROM=Cadence <no-reply@your-domain.com>
# spring.mail.host=smtp.resend.com
# spring.mail.port=587
# spring.mail.username=resend
# spring.mail.password=your_smtp_password_or_api_key
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true

# --- Real deployment: no demo accounts, and a first admin created from config ---
# APP_SEED_DEMO_DATA=false
# BOOTSTRAP_ADMIN_EMAIL=you@your-company.com
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_PASSWORD=choose_a_long_unique_password
