DB_PASSWORD=postgres_password
JWT_SECRET=generate_a_long_random_base64_string
DB_URL=db_url
APP_JWT_COOKIE_SECURE=false

# --- Frontend URL used in emailed links (no trailing slash) ---
APP_FRONTEND_URL=http://localhost:5173

# --- Email. Leave APP_MAIL_ENABLED=false in development: invite and reset links are printed in the backend log.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=Cadence <your-sender-address@example.com>

# Option 1: Gmail API over HTTPS (works on hosts that block SMTP, e.g. Render's free tier; no domain needed).
# Get the three values by following "Sending email with the Gmail API" in AUTH_UPGRADE.md.
# APP_MAIL_PROVIDER=gmail-api
# GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token

# Option 2: any SMTP provider (Resend, SES, Brevo, Gmail SMTP...) - only where outbound SMTP is allowed.
# APP_MAIL_PROVIDER=smtp
# spring.mail.host=smtp.resend.com
# spring.mail.port=587
# spring.mail.username=resend
# spring.mail.password=your_smtp_password_or_api_key
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# spring.mail.properties.mail.smtp.connectiontimeout=5000
# spring.mail.properties.mail.smtp.timeout=5000
# spring.mail.properties.mail.smtp.writetimeout=5000
# (On a host such as Render, set these as environment variables instead: SPRING_MAIL_HOST, SPRING_MAIL_PORT, ...)

# --- deployment ---
# APP_SEED_DEMO_DATA=false
# BOOTSTRAP_ADMIN_EMAIL=you@your-company.com
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_PASSWORD=choose_a_long_unique_password
